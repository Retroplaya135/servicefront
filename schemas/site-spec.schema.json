{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/site-spec.schema.json",
  "title": "Servicefront SiteSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "contact",
    "services",
    "pages",
    "theme",
    "seo",
    "forms",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "businessType",
        "city",
        "state"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "businessType": {
          "type": "string",
          "enum": [
            "painting_contractor"
          ]
        },
        "tagline": {
          "type": "string",
          "maxLength": 160
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "postalCode": {
          "type": "string",
          "maxLength": 16
        },
        "logoAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "textWordmark": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone",
        "primaryCta"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "displayPhone": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "primaryCta": {
          "type": "string",
          "enum": [
            "request_estimate",
            "call_now",
            "get_quote"
          ]
        },
        "hours": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "closed"
            ],
            "properties": {
              "day": {
                "type": "string",
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              },
              "closed": {
                "type": "boolean"
              },
              "opens": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              },
              "closes": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "summary",
          "enabled"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          },
          "body": {
            "type": "string",
            "maxLength": 2400
          },
          "enabled": {
            "type": "boolean"
          },
          "imageAssetId": {
            "type": "string",
            "format": "uuid"
          },
          "pagePath": {
            "type": "string",
            "pattern": "^/[a-z0-9-]+$"
          }
        }
      }
    },
    "serviceAreas": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "reviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "licensed": {
          "type": "boolean"
        },
        "insured": {
          "type": "boolean"
        },
        "yearsInBusiness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "guarantees": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 180
          }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "sourceType"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 10,
            "maxLength": 600
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "client_supplied",
              "public_review",
              "fictional_demo"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceCapturedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "role",
          "rightsStatus",
          "placeholder"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "logo",
              "hero",
              "project",
              "service",
              "team",
              "background"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 300
          },
          "rightsStatus": {
            "type": "string",
            "enum": [
              "client_owned",
              "licensed",
              "generated",
              "unknown"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "placeholder": {
            "type": "boolean"
          },
          "focalX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "focalY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "title",
          "sections",
          "enabled"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(?:[a-z0-9-]+)?$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "enabled": {
            "type": "boolean"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "component",
                "variant",
                "enabled"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                },
                "component": {
                  "type": "string",
                  "enum": [
                    "hero",
                    "trust_bar",
                    "service_grid",
                    "before_after",
                    "project_gallery",
                    "review_wall",
                    "process",
                    "about_story",
                    "service_areas",
                    "faq",
                    "estimate_form",
                    "final_cta"
                  ]
                },
                "variant": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "enabled": {
                  "type": "boolean"
                },
                "headline": {
                  "type": "string",
                  "maxLength": 160
                },
                "body": {
                  "type": "string",
                  "maxLength": 1800
                },
                "dataKey": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeKey",
        "accent",
        "tone"
      ],
      "properties": {
        "recipeKey": {
          "type": "string",
          "enum": [
            "painting-premium",
            "painting-trusted-local",
            "painting-gallery-first"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "tone": {
          "type": "string",
          "enum": [
            "light",
            "balanced",
            "dark"
          ]
        },
        "heroVariant": {
          "type": "string",
          "maxLength": 50
        },
        "galleryVariant": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteTitle",
        "defaultDescription",
        "robots"
      ],
      "properties": {
        "siteTitle": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "defaultDescription": {
          "type": "string",
          "minLength": 50,
          "maxLength": 170
        },
        "canonicalBaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "robots": {
          "type": "string",
          "enum": [
            "noindex,nofollow,noarchive",
            "index,follow"
          ]
        },
        "structuredDataEnabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimateFormEnabled",
        "successMessage"
      ],
      "properties": {
        "estimateFormEnabled": {
          "type": "boolean"
        },
        "formDefinitionId": {
          "type": "string",
          "format": "uuid"
        },
        "successMessage": {
          "type": "string",
          "maxLength": 300
        },
        "privacyNotice": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "generationMode",
        "evidence"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generationMode": {
          "type": "string",
          "enum": [
            "deterministic",
            "ai_enriched",
            "operator",
            "owner",
            "fictional_demo"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "capturedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "lead_source",
                  "website",
                  "public_profile",
                  "client_confirmation",
                  "client_asset",
                  "licensed_asset",
                  "generated_asset",
                  "operator_note"
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 500
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time"
              },
              "notes": {
                "type": "string",
                "maxLength": 800
              }
            }
          }
        }
      }
    }
  }
}
